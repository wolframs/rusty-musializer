{
  "schema": "musializer.listening-test/v1",
  "id": "replace-with-session-id",
  "title": "Name the real comparison",
  "instructions": "Tell the listener what evidence to attend to without revealing candidate identity.",
  "blind": true,
  "feedback_templates": {
    "timing-choice": {
      "fields": [
        {
          "id": "confidence",
          "type": "scale",
          "label": "How clear was the preference?",
          "required": true,
          "options": [
            { "value": "guess", "label": "Close to a guess" },
            { "value": "lean", "label": "A slight preference" },
            { "value": "clear", "label": "Immediately clear" }
          ]
        },
        {
          "id": "decisive_times",
          "type": "timestamps",
          "label": "Capture the moments that decided it",
          "max_selections": 3
        },
        {
          "id": "neither_reason",
          "type": "multi",
          "label": "Why is neither right?",
          "required": true,
          "show_when": { "field": "answer", "any_of": ["neither"] },
          "options": [
            { "value": "both-early", "label": "Both early" },
            { "value": "both-late", "label": "Both late" },
            { "value": "different-errors", "label": "Different errors" }
          ]
        }
      ],
      "note": {
        "collapsed": true,
        "label": "Add context the controls missed"
      }
    }
  },
  "tracks": [
    {
      "id": "internal-current",
      "label": "Current render",
      "path": "/absolute/path/to/current.wav"
    },
    {
      "id": "internal-candidate",
      "label": "Candidate render",
      "path": "/absolute/path/to/candidate.wav"
    }
  ],
  "questions": [
    {
      "id": "q01",
      "at_seconds": 42.125,
      "window": { "pre": 2.0, "post": 8.0 },
      "question": "Which version places the onset more convincingly?",
      "detail": "Listen for the first consonant and note its exact time if neither is right.",
      "kind": "choice",
      "options": ["A", "B", "either", "neither"],
      "tracks": ["internal-current", "internal-candidate"],
      "loop": true,
      "required": true,
      "feedback": "timing-choice"
    },
    {
      "id": "q02",
      "at_seconds": 68.0,
      "window": { "pre": 3.0, "post": 10.0 },
      "question": "What changed in the second version?",
      "kind": "text",
      "tracks": ["internal-current", "internal-candidate"],
      "required": false
    }
  ]
}

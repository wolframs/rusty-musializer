{
  "schema": "musializer.listening-test/v1",
  "id": "cx4-surprise-a-feedback",
  "title": "CX-4 Surprise keepability - Ctrl+Z The Apocalypse.mp3 — feedback sheet",
  "instructions": "Keep the Rust visual runner and this sheet on the same question number. Judge the look in Rust, answer here, then press N in Rust to advance. Do not open the .key.json until both sessions are complete.",
  "blind": true,
  "playback": "external",
  "companion": {
    "label": "Rust visual protocol runner",
    "command": "cargo run -- --protocol build/protocols/cx4-surprise-a.protocol.json",
    "help": "The Rust app owns audio, scene state, and blind A/B order. This browser owns only the structured feedback log."
  },
  "tracks": [
    {
      "id": "reference-audio",
      "label": "Ctrl+Z The Apocalypse.mp3",
      "path": "/home/wolfram/Music/Ctrl+Z The Apocalypse.mp3"
    }
  ],
  "feedback_templates": {
    "cx4-single": {
      "fields": [
        {
          "id": "track_fit",
          "type": "scale",
          "label": "How naturally does the look fit this music?",
          "help": "Judge the relationship, not whether either the song or scene is good by itself.",
          "required": true,
          "show_when": {
            "field": "answer",
            "any_of": [
              "keep",
              "interesting but needs fixing",
              "reject"
            ]
          },
          "options": [
            {
              "value": "fights",
              "label": "Fights it",
              "description": "The visual energy contradicts the music."
            },
            {
              "value": "loose",
              "label": "Loosely related",
              "description": "Plausible, but it could belong to many tracks."
            },
            {
              "value": "works",
              "label": "Works with it",
              "description": "The major visual choices support the passage."
            },
            {
              "value": "authored",
              "label": "Feels authored",
              "description": "It looks deliberately made for this passage."
            }
          ]
        },
        {
          "id": "strengths",
          "type": "multi",
          "label": "What earns the result its value?",
          "help": "Choose up to three. These tell the agent what not to erase while tuning.",
          "max_selections": 3,
          "show_when": {
            "field": "answer",
            "any_of": [
              "keep",
              "interesting but needs fixing"
            ]
          },
          "options": [
            {
              "value": "music-fit",
              "label": "Fits the music"
            },
            {
              "value": "composition",
              "label": "Strong composition"
            },
            {
              "value": "motion",
              "label": "Motion feels alive"
            },
            {
              "value": "palette",
              "label": "Palette works"
            },
            {
              "value": "depth",
              "label": "Good depth / layering"
            },
            {
              "value": "distinctive",
              "label": "Distinctive identity"
            }
          ]
        },
        {
          "id": "repairs",
          "type": "multi",
          "label": "What most needs attention?",
          "help": "Choose one to three concrete failure modes.",
          "required": true,
          "max_selections": 3,
          "show_when": {
            "field": "answer",
            "any_of": [
              "interesting but needs fixing",
              "reject"
            ]
          },
          "options": [
            {
              "value": "too-busy",
              "label": "Too busy"
            },
            {
              "value": "too-static",
              "label": "Too static"
            },
            {
              "value": "weak-focus",
              "label": "Weak focal point"
            },
            {
              "value": "palette-mismatch",
              "label": "Palette misses the track"
            },
            {
              "value": "motion-mismatch",
              "label": "Motion misses the rhythm"
            },
            {
              "value": "generic",
              "label": "Feels generic"
            },
            {
              "value": "illegible",
              "label": "Hard to read visually"
            }
          ]
        },
        {
          "id": "repair_distance",
          "type": "scale",
          "label": "How far is it from keepable?",
          "required": true,
          "show_when": {
            "field": "answer",
            "any_of": [
              "interesting but needs fixing"
            ]
          },
          "options": [
            {
              "value": "small",
              "label": "One small tweak"
            },
            {
              "value": "focused",
              "label": "A focused tuning pass"
            },
            {
              "value": "large",
              "label": "Most of the look needs rebuilding"
            }
          ]
        }
      ],
      "note": {
        "collapsed": true,
        "label": "Add a note only if the controls missed something",
        "placeholder": "Name the visual moment or change the controls could not express."
      }
    },
    "cx4-pair": {
      "fields": [
        {
          "id": "difference",
          "type": "scale",
          "label": "How visually distinct were the two looks?",
          "help": "This directly checks whether consecutive Surprise presses produce meaningfully different results.",
          "required": true,
          "show_when": {
            "field": "answer",
            "any_of": [
              "the first look",
              "the second look",
              "either",
              "neither"
            ]
          },
          "options": [
            {
              "value": "barely",
              "label": "Barely different"
            },
            {
              "value": "noticeable",
              "label": "Noticeably different"
            },
            {
              "value": "clear",
              "label": "Clearly different"
            },
            {
              "value": "direction",
              "label": "Different directions"
            }
          ]
        },
        {
          "id": "separators",
          "type": "multi",
          "label": "What separated them?",
          "help": "Choose up to three dimensions that actually changed the judgment.",
          "max_selections": 3,
          "show_when": {
            "field": "answer",
            "any_of": [
              "the first look",
              "the second look",
              "either",
              "neither"
            ]
          },
          "options": [
            {
              "value": "music-fit",
              "label": "Fit to the music"
            },
            {
              "value": "composition",
              "label": "Composition"
            },
            {
              "value": "motion",
              "label": "Motion"
            },
            {
              "value": "palette",
              "label": "Palette"
            },
            {
              "value": "intensity",
              "label": "Intensity"
            },
            {
              "value": "identity",
              "label": "Distinctiveness"
            }
          ]
        },
        {
          "id": "neither_problem",
          "type": "multi",
          "label": "Why was neither keepable?",
          "required": true,
          "max_selections": 2,
          "show_when": {
            "field": "answer",
            "any_of": [
              "neither"
            ]
          },
          "options": [
            {
              "value": "busy",
              "label": "Both too busy"
            },
            {
              "value": "static",
              "label": "Both too static"
            },
            {
              "value": "generic",
              "label": "Both feel generic"
            },
            {
              "value": "track-mismatch",
              "label": "Both miss the track"
            },
            {
              "value": "different-flaws",
              "label": "Different flaws"
            }
          ]
        },
        {
          "id": "confidence",
          "type": "single",
          "label": "How clear was your preference?",
          "required": true,
          "show_when": {
            "field": "answer",
            "any_of": [
              "the first look",
              "the second look",
              "either",
              "neither"
            ]
          },
          "options": [
            {
              "value": "guess",
              "label": "Close to a guess"
            },
            {
              "value": "lean",
              "label": "A real but slight preference"
            },
            {
              "value": "clear",
              "label": "Immediately clear"
            }
          ]
        }
      ],
      "note": {
        "collapsed": true,
        "label": "Add a note only if the controls missed something",
        "placeholder": "Describe the decisive difference the choices did not capture."
      }
    }
  },

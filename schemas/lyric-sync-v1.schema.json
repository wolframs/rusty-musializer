{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musializer.local/schemas/lyric-sync-v1.schema.json",
  "title": "Musializer known-lyrics synchronization v1",
  "description": "Deterministic localization of authored reference lyrics against acoustic evidence. Display text is authored truth; timing is acoustic evidence; a line that cannot be located is unresolved and flagged, never silently absent. Since tranche LT1 the anchor/block localizer writes this shape as well, adding the optional localization, review and audit blocks below.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane",
    "aligner_version",
    "audio",
    "reference",
    "provenance",
    "lines",
    "unmatched",
    "structure",
    "unreliable_evidence",
    "statistics"
  ],
  "properties": {
    "schema_version": {
      "const": "musializer.lyric-sync/v1"
    },
    "lane": {
      "const": "lyric_sync"
    },
    "aligner_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "audio": {
      "type": "object"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "text",
          "reason"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "kind",
          "text"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "section",
              "event",
              "delivery"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "unreliable_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "end_seconds"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_lines",
        "matched_lines",
        "estimated_lines",
        "unmatched_lines",
        "reference_tokens"
      ],
      "properties": {
        "reference_lines": {
          "type": "integer",
          "minimum": 0
        },
        "matched_lines": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_lines": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_lines": {
          "type": "integer",
          "minimum": 0
        },
        "matched_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reference_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_lines": {
          "type": "integer",
          "minimum": 0
        },
        "abstained_lines": {
          "type": "integer",
          "minimum": 0
        },
        "review_flagged_lines": {
          "type": "integer",
          "minimum": 0
        },
        "coarse_disagreement_lines": {
          "type": "integer",
          "minimum": 0
        },
        "anchor_count": {
          "type": "integer",
          "minimum": 0
        },
        "block_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "order_violations": {
          "type": "integer",
          "minimum": 0
        },
        "discarded_outlier_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "recovered_outlier_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "recovered_nearby_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "localization_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "localization_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "unresolved": {
      "description": "Alignable authored lines with no cue, by name and reason. Cues plus unresolved always account for every alignable authored line.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "text",
          "reason"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "line_position": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "lyric",
              "backing"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "abstained": {
            "type": "boolean"
          },
          "coarse_start_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "coarse_end_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "acoustic_start_seconds": {
            "description": "Rejected fine-placement proposal retained for audit; never a published cue.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "acoustic_end_seconds": {
            "description": "Rejected fine-placement proposal retained for audit; never a published cue.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "independent_global_candidate": {
            "description": "Unconditioned anchor/global challenger retained when it rejected a coarse-conditioned path.",
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "review_flags": {
      "description": "Lines a human should check: cross-view disagreement, a rare anchor overriding the unconditioned path, or unresolved. Never derived from the aligner's own score.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "text",
          "flag"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "flag": {
            "enum": [
              "coarse_disagreement",
              "global_disagreement_anchor_resolved",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "start_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "coarse_start_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "delta_seconds": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "anchors": {
      "description": "Rare n-grams unique in both the authored text and the evidence, in authored order.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blocks": {
      "description": "Ordered search partitions between anchors, including the initial and terminal blocks.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "order_violations": {
      "description": "Timed lines whose start goes backwards against authored order.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generation": {
      "description": "Input digests this lane was produced from.",
      "type": "object"
    },
    "timing_refinement": {
      "description": "Acoustic adapter, policy versions and request identity for the aligned artifact.",
      "type": "object"
    }
  },
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_seconds",
        "end_seconds",
        "text",
        "kind",
        "reference_line_index",
        "confidence",
        "estimated",
        "uncertain"
      ],
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "lyric",
            "backing"
          ]
        },
        "reference_line_index": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "estimated": {
          "type": "boolean"
        },
        "uncertain": {
          "type": "boolean"
        },
        "line_position": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "score": {
          "description": "The aligner's own CTC score. Audit evidence only: it does not order correct from incorrect and is never a confidence.",
          "type": "number"
        },
        "first_word_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_word_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "word_alignments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "block_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "candidate_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "coarse_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "independent_block_candidate": {
          "description": "Section/block challenger retained when a bounded coarse-local refinement wins.",
          "type": "object"
        },
        "independent_global_candidate": {
          "description": "Unconditioned anchor/global challenger retained when section windows were derived from coarse evidence.",
          "type": "object"
        },
        "global_disagreement_anchor_resolved": {
          "description": "The unconditioned path picked another occurrence, while a rare exact anchor resolved this section; remains a review flag.",
          "type": "boolean"
        },
        "coarse_start_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "coarse_end_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "review_flagged": {
          "type": "boolean"
        },
        "forced_alignment": {
          "description": "Per-cue MMS audit record, no-reference lane only.",
          "type": "object"
        }
      }
    }
  }
}

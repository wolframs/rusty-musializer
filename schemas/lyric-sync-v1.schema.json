{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musializer.local/schemas/lyric-sync-v1.schema.json",
  "title": "Musializer known-lyrics synchronization v1",
  "description": "Deterministic localization of authored reference lyrics against acoustic evidence. Display text is authored truth; timing is acoustic evidence; a line that cannot be located is unresolved and flagged, never silently absent. Since tranche LT1 the anchor/block localizer writes this shape as well, adding the optional localization, review and audit blocks below.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane",
    "aligner_version",
    "audio",
    "reference",
    "provenance",
    "lines",
    "unmatched",
    "structure",
    "unreliable_evidence",
    "statistics"
  ],
  "properties": {
    "schema_version": {
      "const": "musializer.lyric-sync/v1"
    },
    "lane": {
      "const": "lyric_sync"
    },
    "aligner_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "audio": {
      "type": "object"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "performed_candidates": {
      "description": "Short ASR spans outside every authored placement. Review evidence only; never an automatically accepted lyric cue.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "end_seconds",
          "text",
          "confidence",
          "source",
          "uncertain",
          "reason"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "const": "whisper-unmatched"
          },
          "uncertain": {
            "const": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "text",
          "reason"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "kind",
          "text"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "section",
              "event",
              "delivery"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "unreliable_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "end_seconds"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_lines",
        "matched_lines",
        "estimated_lines",
        "unmatched_lines",
        "reference_tokens"
      ],
      "properties": {
        "reference_lines": {
          "type": "integer",
          "minimum": 0
        },
        "matched_lines": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_lines": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_lines": {
          "type": "integer",
          "minimum": 0
        },
        "performed_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "matched_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reference_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_lines": {
          "type": "integer",
          "minimum": 0
        },
        "abstained_lines": {
          "type": "integer",
          "minimum": 0
        },
        "review_flagged_lines": {
          "type": "integer",
          "minimum": 0
        },
        "coarse_disagreement_lines": {
          "type": "integer",
          "minimum": 0
        },
        "anchor_count": {
          "type": "integer",
          "minimum": 0
        },
        "block_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "order_violations": {
          "type": "integer",
          "minimum": 0
        },
        "discarded_outlier_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "recovered_outlier_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "recovered_nearby_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds": {
          "type": "number",
          "minimum": 0
        },
        "performed_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "phrase_splits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "localization_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "localization_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "unresolved": {
      "description": "Alignable authored lines with no cue, by name and reason. Cues plus unresolved always account for every alignable authored line.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "text",
          "reason"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "line_position": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "lyric",
              "backing"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "abstained": {
            "type": "boolean"
          },
          "coarse_start_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "coarse_end_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "acoustic_start_seconds": {
            "description": "Rejected fine-placement proposal retained for audit; never a published cue.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "acoustic_end_seconds": {
            "description": "Rejected fine-placement proposal retained for audit; never a published cue.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "independent_global_candidate": {
            "description": "Unconditioned anchor/global challenger retained when it rejected a coarse-conditioned path.",
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "review_flags": {
      "description": "Lines a human should check: cross-view disagreement, a rare anchor overriding the unconditioned path, or unresolved. Never derived from the aligner's own score.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_line_index",
          "text",
          "flag"
        ],
        "properties": {
          "reference_line_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "flag": {
            "enum": [
              "coarse_disagreement",
              "global_disagreement_anchor_resolved",
              "audio_occurrence_recovered",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "start_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "coarse_start_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "delta_seconds": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "anchors": {
      "description": "Rare n-grams unique in both the authored text and the evidence, in authored order.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blocks": {
      "description": "Ordered search partitions between anchors, including the initial and terminal blocks.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "order_violations": {
      "description": "Timed lines whose start goes backwards against authored order.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generation": {
      "description": "Input digests this lane was produced from.",
      "type": "object"
    },
    "audio_occurrence_recovery": {
      "description": "Missing authored occurrences recovered from distinct original audio crops, with ambiguous alternatives retained unresolved.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "recovered",
        "declined_ambiguous",
        "declined_order",
        "declined_competing"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "recovered": {
          "type": "integer",
          "minimum": 0
        },
        "declined_ambiguous": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "declined_order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "declined_competing": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "audio_boundary_refinement": {
      "description": "Optional authored-boundary refinement from separately cropped audio observations; indices refer to input cue positions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "refined",
        "collisions",
        "declined_order",
        "policy"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "refined": {
          "type": "integer",
          "minimum": 0
        },
        "collisions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "declined_order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "timing_refinement": {
      "description": "Acoustic adapter, policy versions and request identity for the aligned artifact.",
      "type": "object"
    },
    "performed_occurrences": {
      "description": "Additional audio-confirmed performances, with authored templates or explicit audio_observed wording; separate from the authored ledger.",
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/performed_occurrence"
      }
    },
    "occurrence_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "proposed",
        "confirmed",
        "request_identity",
        "source_sha256",
        "observations"
      ],
      "properties": {
        "version": {
          "enum": [
            "1",
            "2"
          ]
        },
        "proposed": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "request_identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clip_start_seconds",
              "clip_duration_seconds",
              "clip_sha256",
              "lines"
            ],
            "properties": {
              "clip_start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "clip_duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              },
              "clip_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "phrase_splits": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_kind",
          "source_index",
          "source_sha256",
          "phrases"
        ],
        "properties": {
          "source_kind": {
            "enum": [
              "lines",
              "performed_occurrences"
            ]
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "phrases": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/performed_occurrence"
            }
          }
        }
      }
    },
    "phrase_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "proposed",
        "confirmed",
        "request_identity",
        "source_sha256",
        "observations"
      ],
      "properties": {
        "version": {
          "enum": [
            "1",
            "2"
          ]
        },
        "proposed": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "request_identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clip_start_seconds",
              "clip_duration_seconds",
              "clip_sha256",
              "lines"
            ],
            "properties": {
              "clip_start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "clip_duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              },
              "clip_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "observed_occurrence_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "proposed",
        "confirmed",
        "request_identity",
        "source_sha256",
        "observations"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "proposed": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "request_identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clip_start_seconds",
              "clip_duration_seconds",
              "clip_sha256",
              "lines"
            ],
            "properties": {
              "clip_start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "clip_duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              },
              "clip_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "audio_occurrence_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_alignment",
        "observations"
      ],
      "properties": {
        "previous_alignment": {
          "$ref": "#/properties/unresolved/items"
        },
        "observations": {
          "$ref": "#/$defs/audio_boundary_evidence/properties/observations"
        }
      }
    },
    "boundary_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_seconds",
        "end_seconds"
      ],
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "audio_boundary_evidence": {
      "description": "The prior cue and matching original-crop intervals. Existing word alignments remain the acoustic adapter's diagnostic evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original",
        "observations"
      ],
      "properties": {
        "original": {
          "$ref": "#/$defs/boundary_window"
        },
        "observations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clip_index",
              "first_row",
              "last_row",
              "start_seconds",
              "end_seconds",
              "similarity"
            ],
            "properties": {
              "clip_index": {
                "type": "integer",
                "minimum": 0
              },
              "first_row": {
                "type": "integer",
                "minimum": 0
              },
              "last_row": {
                "type": "integer",
                "minimum": 0
              },
              "start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "end_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "similarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_seconds",
        "end_seconds",
        "text",
        "kind",
        "reference_line_index",
        "confidence",
        "estimated",
        "uncertain"
      ],
      "properties": {
        "audio_boundary_evidence": {
          "$ref": "#/$defs/audio_boundary_evidence"
        },
        "audio_occurrence_evidence": {
          "$ref": "#/$defs/audio_occurrence_evidence"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "lyric",
            "backing"
          ]
        },
        "reference_line_index": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "estimated": {
          "type": "boolean"
        },
        "uncertain": {
          "type": "boolean"
        },
        "line_position": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "score": {
          "description": "The aligner's own CTC score. Audit evidence only: it does not order correct from incorrect and is never a confidence.",
          "type": "number"
        },
        "first_word_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_word_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "word_alignments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "block_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "candidate_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "coarse_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "independent_block_candidate": {
          "description": "Section/block challenger retained when a bounded coarse-local refinement wins.",
          "type": "object"
        },
        "independent_global_candidate": {
          "description": "Unconditioned anchor/global challenger retained when section windows were derived from coarse evidence.",
          "type": "object"
        },
        "global_disagreement_anchor_resolved": {
          "description": "The unconditioned path picked another occurrence, while a rare exact anchor resolved this section; remains a review flag.",
          "type": "boolean"
        },
        "coarse_start_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "coarse_end_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "review_flagged": {
          "type": "boolean"
        },
        "forced_alignment": {
          "description": "Per-cue MMS audit record, no-reference lane only.",
          "type": "object"
        }
      }
    },
    "performed_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start_seconds",
        "end_seconds",
        "reference_line_indices",
        "confidence",
        "uncertain",
        "reason",
        "occurrence_evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_line_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "confidence": {
          "type": "null"
        },
        "uncertain": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "occurrence_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discovery",
            "confirmation"
          ],
          "properties": {
            "discovery": {
              "$ref": "#/$defs/audio_boundary_evidence/properties/observations"
            },
            "confirmation": {
              "$ref": "#/$defs/audio_boundary_evidence/properties/observations"
            }
          }
        },
        "text_scope": {
          "enum": [
            "authored_inline_lead",
            "audio_observed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "text_scope": {
                "const": "audio_observed"
              }
            },
            "required": [
              "text_scope"
            ]
          },
          "then": {
            "properties": {
              "reference_line_indices": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "reference_line_indices": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}

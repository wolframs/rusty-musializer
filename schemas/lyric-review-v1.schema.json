{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musializer.local/schemas/lyric-review-v1.schema.json",
  "title": "Musializer evidence-preserving lyric review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane", "audio", "source", "provenance", "lines", "notes"],
  "properties": {
    "schema_version": {"const": "musializer.lyric-review/v1"},
    "lane": {"const": "lyric_review"},
    "audio": {"type": "object"},
    "source": {"type": "object"},
    "provenance": {"type": "object"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_lines", "cited_source_lines", "uncited_reliable_source_lines", "suspected_hallucination_intervals"],
      "properties": {
        "source_lines": {"type": "integer", "minimum": 0},
        "cited_source_lines": {"type": "integer", "minimum": 0},
        "uncited_reliable_source_lines": {"type": "integer", "minimum": 0},
        "suspected_hallucination_intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_seconds", "end_seconds"],
            "properties": {
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {"$ref": "#/$defs/line"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "text", "source_line_indices", "confidence", "uncertain"],
      "properties": {
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "text": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_line_indices": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertain": {"type": "boolean"}
      }
    }
  }
}
